{
  "name": "hwan-h-heo-portfolio",
  "version": "1.0.0",
  "description": "Hwan Heo's portfolio site with integrated blog",
  "scripts": {
    "setup": "npm install && npm --prefix blogs install",
    "build": "npm --prefix blogs run build",
    "build:incremental": "npm --prefix blogs run build:incremental",
    "dev": "npm --prefix blogs run dev",
    "deploy": "npm run verify && npm --prefix blogs run deploy:dist",
    "deploy:quick": "node scripts/quick-deploy.js",
    "new:post": "node scripts/new-post.js",
    "new:project": "node scripts/new-project.js",
    "check:content": "node scripts/check-content.js",
    "check:assets": "node scripts/check-assets.js",
    "audit:assets": "node scripts/audit-static-assets.js",
    "check:legacy-ui": "node scripts/check-legacy-ui.js",
    "check:render": "node scripts/check-rendered-site.js",
    "check:ui": "node scripts/check-ui-regression.js",
    "capture:ui": "node scripts/check-ui-regression.js --screenshots-dir=artifacts/ui-regression",
    "validate:seo": "node scripts/validate-seo-output.js",
    "verify": "npm run check:content && npm run check:assets && npm run audit:assets && npm run build && npm run validate:seo && npm run check:legacy-ui && npm run check:render && npm run check:ui",
    "verify:production": "node scripts/check-rendered-site.js --production",
    "freeze:routes": "node scripts/freeze-route-compatibility.js"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "playwright": "^1.61.1"
  }
}
